# Copy this file to .env and fill in your key to run live extraction.

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# true  -> use pre-generated extractions in data/mock_extractions.json (no API key needed)
# false -> call the real Claude API for every invoice in data/invoices/
MOCK_MODE=true

# Optional: override the model used for live extraction
CLAUDE_MODEL=claude-sonnet-4-6
